{
  "opencollection": "1.0.0",
  "info": {
    "name": "Instamojo Payments Authentication API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.instamojo.com/v2/oauth2/token/",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Generate an OAuth2 access token using client credentials. Provide client_id and client_secret to receive a bearer token for subsequent API calls.\n"
        }
      ]
    }
  ],
  "bundled": true
}